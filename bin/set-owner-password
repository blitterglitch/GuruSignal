#!/usr/bin/env python3
"""Hash an interactively entered owner password into an ignored local file."""

import getpass
import os
from pathlib import Path
import subprocess
import sys
import tempfile

root = Path(__file__).resolve().parent.parent
password = getpass.getpass("New owner password (at least 16 characters): ")
if len(password) < 16 or len(password.encode()) > 1024:
    sys.exit("Use at least 16 characters and at most 1024 UTF-8 bytes.")
if password != getpass.getpass("Confirm owner password: "):
    sys.exit("Passwords do not match.")

directory = root / ".local-tools"
directory.mkdir(exist_ok=True, mode=0o700)
descriptor, temporary = tempfile.mkstemp(dir=directory, prefix="owner-hash-")
os.close(descriptor)
try:
    env = os.environ.copy()
    env["MIX_ENV"] = "dev"
    env["OWNER_NEW_PASSWORD"] = password
    env["OWNER_HASH_FILE"] = temporary
    subprocess.run(
        [
            sys.executable, str(root / "bin/mix-local"), "run", "--no-start", "-e",
            'File.write!(System.fetch_env!("OWNER_HASH_FILE"), '
            'Pbkdf2.hash_pwd_salt(System.fetch_env!("OWNER_NEW_PASSWORD")))',
        ],
        env=env, check=True,
    )
    os.replace(temporary, directory / "owner_password_hash")
except subprocess.CalledProcessError as error:
    sys.exit(f"Password setup failed (Mix exit {error.returncode}). Fix the error above and retry.")
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)
print("Owner password hash saved locally. Restart the server to use it.")
