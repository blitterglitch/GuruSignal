#!/usr/bin/env python3
"""Stage Fly trial secrets through private prompts and the CLI's standard input."""
import getpass
import os
from pathlib import Path
import secrets
import shutil
import subprocess
import sys
import tomllib
from urllib.parse import parse_qsl, urlsplit, urlunsplit

def normalize_database_url(value):
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {"'", '"'}:
        value = value[1:-1]
    if any(character.isspace() for character in value):
        raise ValueError("Paste the connection URL itself, beginning postgresql://, without a psql command or spaces.")
    try:
        parsed = urlsplit(value)
        host = parsed.hostname or ""
        _ = parsed.port
    except ValueError:
        raise ValueError("The URL could not be parsed. Copy the full direct connection URL from the cluster's Connect tab.") from None
    if parsed.scheme not in {"postgres", "postgresql", "ecto"}:
        raise ValueError("Paste the full connection URL beginning postgresql://, including user, password, hostname, and database.")
    if host.startswith("pgbouncer."):
        raise ValueError("This is the pooled URL. Select Direct in the cluster's Connect tab for this trial.")
    if not (host.startswith("direct.") and host.endswith(".flympg.net")):
        raise ValueError("Use the Direct connection URL from this Managed Postgres cluster's Connect tab.")
    if not parsed.username or not parsed.password or parsed.path in {"", "/"}:
        raise ValueError("The connection URL must include the username, password, and database name.")
    if parsed.fragment:
        raise ValueError("The URL contains a fragment; special characters in credentials must be percent-encoded.")
    try:
        options = parse_qsl(parsed.query, keep_blank_values=True, strict_parsing=True)
    except ValueError:
        raise ValueError("The connection URL has malformed query options.") from None
    for key, value in options:
        if not ((key == "ssl" and value == "true") or
                (key == "sslmode" and value in {"require", "verify-ca", "verify-full"})):
            raise ValueError("Use a Direct URL with only ssl=true or sslmode=require/verify-ca/verify-full options. Verified TLS remains required.")
    # The app config enables verified TLS; Ecto URL options must not override it.
    return urlunsplit((parsed.scheme, parsed.netloc, parsed.path, "", ""))


root = Path(__file__).resolve().parent.parent
config = tomllib.loads((root / "fly.trial.toml").read_text())
app = config["app"]
fly = shutil.which("fly") or shutil.which("flyctl")
if not fly:
    sys.exit("Install flyctl and sign in first.")
if not sys.stdin.isatty():
    sys.exit("Run this helper in an interactive terminal so secret prompts remain private.")
print(f"Staging secrets for trial app {app}. No deployment will be started.")
if config.get("env", {}).get("DATABASE_SSL") != "true":
    sys.exit("The trial configuration must set DATABASE_SSL=true for verified TLS.")
print("Fly dashboard → Managed Postgres → this cluster → Connect → Direct connection URL.")
try:
    url = normalize_database_url(getpass.getpass("Paste the full direct database URL (hidden): "))
except ValueError as error:
    sys.exit(str(error))
password = getpass.getpass("New trial owner password (at least 16 characters): ")
if len(password) < 16 or len(password.encode()) > 1024:
    sys.exit("Use at least 16 characters and at most 1024 UTF-8 bytes.")
if password != getpass.getpass("Confirm trial owner password: "):
    sys.exit("Passwords did not match; no secrets were staged.")
env = os.environ.copy()
env.update(MIX_ENV="dev", OWNER_TRIAL_PASSWORD=password)
result = subprocess.run(
    [sys.executable, str(root / "bin/mix-local"), "run", "--no-start", "-e",
     'IO.puts("TRIAL_HASH=" <> Pbkdf2.hash_pwd_salt(System.fetch_env!("OWNER_TRIAL_PASSWORD"), rounds: 600_000))'],
    cwd=root, env=env, capture_output=True, text=True,
)
if result.returncode:
    sys.exit("Password hashing failed. Check local dependencies/compilation; no secrets were staged.")
hashes = [line.removeprefix("TRIAL_HASH=") for line in result.stdout.splitlines()
          if line.startswith("TRIAL_HASH=$pbkdf2-")]
if len(hashes) != 1:
    sys.exit("Password hashing returned an unexpected result; no secrets were staged.")
payload = (f"DATABASE_URL={url}\nSECRET_KEY_BASE={secrets.token_urlsafe(64)}\n"
           f"OWNER_PASSWORD_HASH={hashes[0]}\n")
# Secrets use stdin, not argv, shell expansion, a generated file, or printed output.
staged = subprocess.run([fly, "secrets", "import", "--stage", "--app", app],
                        input=payload, text=True, capture_output=True, cwd=root)
if staged.returncode:
    sys.exit("Fly could not stage the secrets. Check app access and the dashboard. Secret-bearing command output was withheld.")
print(f"Three secrets staged for {app}. Deploy using fly.trial.toml to activate them.")
